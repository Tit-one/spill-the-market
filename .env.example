# Optional live research. Copy to a LOCAL ignored file; no key is needed for demo/offline modes.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Required known cost per credit in USD. Supply your verified current provider rates.
SPILL_TAVILY_USD_PER_CREDIT=
SPILL_FIRECRAWL_USD_PER_CREDIT=

# Optional structured semantic extraction through any compatible chat-completions endpoint.
SPILL_LLM_BASE_URL=https://api.openai.com/v1
SPILL_LLM_MODEL=
SPILL_LLM_API_KEY=
SPILL_LLM_INPUT_USD_PER_MILLION=
SPILL_LLM_OUTPUT_USD_PER_MILLION=
SPILL_LLM_MAX_INPUT_TOKENS=32000
SPILL_LLM_MAX_OUTPUT_TOKENS=2000
SPILL_LLM_TOKEN_PARAMETER=max_completion_tokens
# Set only if your provider/model accepts it, e.g. none for your tested compatible setup.
SPILL_LLM_REASONING_EFFORT=

# Optional visual page analysis. Explicit opt-in and image-token liability bound.
# Unset MODEL/BASE_URL/API_KEY reuse the explicitly selected LLM configuration.
SPILL_VISION_ENABLED=false
SPILL_VISION_MODEL=
SPILL_VISION_BASE_URL=
SPILL_VISION_API_KEY=
SPILL_VISION_INPUT_USD_PER_MILLION=
SPILL_VISION_OUTPUT_USD_PER_MILLION=
SPILL_VISION_MAX_INPUT_TOKENS=32000
SPILL_VISION_MAX_OUTPUT_TOKENS=3000
SPILL_VISION_MAX_IMAGE_INPUT_TOKENS=
SPILL_VISION_REASONING_EFFORT=
SPILL_VISION_TOKEN_PARAMETER=max_completion_tokens
# Optional local compatible vision server (loopback only, no paid fallback).
SPILL_VISION_LOCAL_URL=http://127.0.0.1:11434/v1
SPILL_VISION_LOCAL_MODEL=

# Optional read-only Graphiti/Neo4j connector. Never modify the existing MiroFish namespace.
SPILL_NEO4J_URI=bolt://127.0.0.1:7687
SPILL_NEO4J_USER=neo4j
SPILL_NEO4J_PASSWORD=
SPILL_NEO4J_DATABASE=neo4j
